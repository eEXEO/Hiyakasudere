<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Hiyakasudere.ViewModels"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             x:Class="Hiyakasudere.Views.BrowseView"
             x:DataType="vm:BrowseViewModel">

    <DockPanel>
        <!-- Search Bar -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <Button Classes="btn-primary" DockPanel.Dock="Right" Margin="8,0,0,0"
                    Command="{Binding SearchCommand}" Content="Search" />
            <TextBox Classes="search-box" Text="{Binding SearchText}"
                     Watermark="Enter tags separated by spaces..."
                     KeyDown="SearchBox_KeyDown" />
        </DockPanel>

        <!-- Recent Searches -->
        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding RecentSearches}" Margin="0,0,0,8"
                      IsVisible="{Binding RecentSearches.Count}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Classes="tag-chip" Cursor="Hand">
                        <TextBlock Text="{Binding}" FontSize="11" Foreground="#8892b0" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Loading bar -->
        <ProgressBar DockPanel.Dock="Top" IsIndeterminate="True" IsVisible="{Binding IsLoading}"
                     Foreground="#e94560" Height="3" Margin="0,0,0,4" />

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="8,6" Background="#16213e" CornerRadius="6,6,0,0">
            <DockPanel>
                <TextBlock Text="{Binding StatusText}" Foreground="#8892b0" FontSize="12"
                           VerticalAlignment="Center" DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4"
                            VerticalAlignment="Center">
                    <Button Classes="page-btn" Command="{Binding PrevPageCommand}" Content="&#x25C0;"
                            FontSize="10" Padding="8,4" />
                    <TextBlock VerticalAlignment="Center" Foreground="#ffffff" FontSize="12" Margin="4,0">
                        <Run Text="{Binding CurrentPage}" />
                        <Run Text="/" />
                        <Run Text="{Binding TotalPages}" />
                    </TextBlock>
                    <Button Classes="page-btn" Command="{Binding NextPageCommand}" Content="&#x25B6;"
                            FontSize="10" Padding="8,4" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Error -->
        <Border DockPanel.Dock="Top" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="#2d1b1b" CornerRadius="8" Padding="16" Margin="0,0,0,8">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#e94560" TextWrapping="Wrap" />
                <Button Classes="btn-secondary" Content="Retry" Command="{Binding SearchCommand}"
                        HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <!-- Masonry Image Grid with Infinite Scroll -->
        <ScrollViewer x:Name="ImageScrollViewer" ScrollChanged="ScrollViewer_ScrollChanged">
            <ItemsControl ItemsSource="{Binding Posts}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="220" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:PostThumbnailViewModel">
                        <Border Classes="image-card" Width="212" Height="{Binding DisplayHeight}"
                                Margin="4" ClipToBounds="True" Cursor="Hand">
                            <Grid>
                                <Image asyncImageLoader:ImageLoader.Source="{Binding PreviewUrl}"
                                       Stretch="UniformToFill" />
                                <!-- Click to open viewer -->
                                <Button Background="Transparent" BorderThickness="0" Opacity="0"
                                        Command="{Binding $parent[ItemsControl].((vm:BrowseViewModel)DataContext).OpenImageCommand}"
                                        CommandParameter="{Binding}"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                <!-- Heart overlay -->
                                <Button Classes="heart-btn" Classes.favorited="{Binding IsFavorited}"
                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                        Command="{Binding $parent[ItemsControl].((vm:BrowseViewModel)DataContext).ToggleFavoriteCommand}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding HeartIcon}" FontSize="16" />
                                </Button>
                                <!-- Score + Rating badge -->
                                <Border Background="#CC000000" CornerRadius="4" Padding="6,3"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding Rating}" FontSize="9" Foreground="#8892b0" />
                                        <TextBlock Text="{Binding Score, StringFormat='♥ {0}'}" FontSize="9" Foreground="#e94560" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>

</UserControl>
