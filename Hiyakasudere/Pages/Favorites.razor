@page "/favorites"
@using Hiyakasudere.Data.Internal.Database
@using Hiyakasudere.Data.Internal.Data.Post
@using Hiyakasudere.Data.Internal.MultiplatformInterfaces
@using Hiyakasudere.Data.Internal.Functionality.ImageUtils
@using Hiyakasudere.Pages.Modals

@inject IFavoritesService FavoritesService
@inject IImageNetUtils ImgNetUtils
@inject IFileManager FileManager

<h5 class="text-center text-white mb-3">Favorites (@totalCount)</h5>

<div class="row">
    @if (favorites == null)
    {
        <div class="d-flex justify-content-center flex-nowrap">
            <div class="spinner-grow text-danger" role="status"></div>
        </div>
    }
    else if (!favorites.Any())
    {
        <div class="d-flex justify-content-center">
            <div class="alert alert-secondary text-center" style="max-width: 400px; margin-top: 40px;">
                <p>No favorites yet!</p>
                <small>Browse posts and click the heart icon to add favorites.</small>
            </div>
        </div>
    }
    else
    {
        int columnCount = 5;
        int chunkSize = (int)Math.Ceiling((double)favorites.Count / columnCount);
        var chunks = favorites
            .Select((value, index) => new { Index = index, Value = value })
            .GroupBy(x => x.Index / chunkSize)
            .Select(g => g.Select(x => x.Value));

        <div class="row">
            @foreach (var chunk in chunks)
            {
                <div class="column">
                    @foreach (var fav in chunk)
                    {
                        <div style="position: relative; display: inline-block; width: 100%;">
                            <img src="@fav.PreviewUrl" style="width: 100%; cursor: pointer;" @onclick="() => ShowFavoriteModal(fav)">
                            <span class="badge bg-danger" style="position: absolute; top: 4px; right: 4px; cursor: pointer;" @onclick="() => RemoveFavorite(fav)">X</span>
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [CascadingParameter] IModalService Modal { get; set; } = default!;

    private List<FavoritePost> favorites;
    private int totalCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadFavorites();
    }

    private async Task LoadFavorites()
    {
        favorites = await FavoritesService.GetAllFavorites();
        totalCount = favorites.Count;
    }

    private async Task RemoveFavorite(FavoritePost fav)
    {
        await FavoritesService.RemoveFavorite(fav.SourcePostId, fav.SourceId);
        await LoadFavorites();
        StateHasChanged();
    }

    private void ShowFavoriteModal(FavoritePost fav)
    {
        // Convert to PostInternal for the modal
        var post = new PostInternal(
            fav.SourcePostId, fav.Tags, fav.AddedAt, "", null,
            fav.Score,
            string.IsNullOrEmpty(fav.PreviewUrl) ? null : new Uri(fav.PreviewUrl), 0, 0,
            string.IsNullOrEmpty(fav.SampleUrl) ? null : new Uri(fav.SampleUrl), 0, 0,
            string.IsNullOrEmpty(fav.OriginalUrl) ? null : new Uri(fav.OriginalUrl), fav.Width, fav.Height,
            0f, fav.Rating, false
        );

        var options = new ModalOptions()
        {
            HideCloseButton = true,
            HideHeader = true,
            Position = ModalPosition.Middle,
            Size = ModalSize.Automatic
        };

        var parameters = new ModalParameters().Add("PostData", post);
        Modal.Show<ModalPostFull>("", parameters, options);
    }
}
